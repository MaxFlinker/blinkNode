<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>blinkNode.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>blinkNode Light</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Icons\*.ico" CopyToOutputDirectory="PreserveNewest" TargetPath="Icons\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
